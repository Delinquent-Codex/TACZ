# Disable autocrlf on generated files, they always generate with LF
# Add any extra files or paths here to make git stop saying they
# are changed when only line endings change.
src/generated/**/.cache/cache text eol=lf
src/generated/**/*.json text eol=lf
gradlew text eol=lf
# Keep captured compiler output verbatim, including diagnostic indentation.
docs/porting/evidence/*.log -text -whitespace
# JVM thread dumps and crash reports are also verbatim runtime evidence.
docs/porting/evidence/*-threads.txt -text -whitespace
docs/porting/evidence/*-crash.txt -text -whitespace
# Preserve historical test-controller/source bytes for recorded input hashes.
docs/porting/evidence/*-harness-*.py -text
docs/porting/evidence/RemoteCheck-*.java -text
docs/porting/evidence/OperatorSequence-*.java -text
docs/porting/evidence/*-server-trace.jsonl -text -whitespace
docs/porting/evidence/ServerTrace-*.java -text
docs/porting/evidence/ShootTraceMixin-*.java -text
docs/porting/evidence/server-trace-config-*.json -text
